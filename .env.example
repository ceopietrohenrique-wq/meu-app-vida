# URL do projeto Supabase (Project Settings > API > Project URL).
# Formato: https://<project-ref>.supabase.co  (sem sufixo de path como /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase. Segura para expor no client (RLS protege os dados).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" do Supabase. NUNCA expor ao client / prefixar com NEXT_PUBLIC_.
# Usada apenas em código server-side (route handlers, server actions, jobs).
SUPABASE_SERVICE_ROLE_KEY=

# Fase 7 — Web Push (VAPID). Gere um par com:
#   node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# (rode `npm install --no-save web-push` antes, é só pra gerar as chaves).
# A pública é segura para expor ao client (é o que o browser usa no
# subscribe()). A privada NUNCA vai para .env.local em produção — só existe
# como secret do projeto Supabase (`supabase secrets set VAPID_PRIVATE_KEY=...`),
# lida exclusivamente pela Edge Function supabase/functions/send-push. Aqui
# em dev local ela só é necessária se você for rodar a Edge Function local
# (supabase functions serve).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
