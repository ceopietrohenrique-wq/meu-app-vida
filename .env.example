# URL do projeto Supabase (Project Settings > API > Project URL).
# Formato: https://<project-ref>.supabase.co  (sem sufixo de path como /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase. Segura para expor no client (RLS protege os dados).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" do Supabase. NUNCA expor ao client / prefixar com NEXT_PUBLIC_.
# Usada apenas em código server-side (route handlers, server actions, jobs).
SUPABASE_SERVICE_ROLE_KEY=
